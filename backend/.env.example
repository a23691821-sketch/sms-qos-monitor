# Port d'écoute de l'API
PORT=3000

# Clé utilisée pour protéger les endpoints d'administration (création de routes, etc.)
ADMIN_API_KEY=change-moi

# Identifiant / mot de passe pour se connecter au dashboard (page /login.html).
# Protège l'ensemble du site (sauf les webhooks fournisseur/app Android, qui
# ne peuvent pas s'authentifier). Change ces valeurs avant de déployer.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-moi-aussi

# Après combien de minutes sans réception un test SMS est considéré "timeout"
TIMEOUT_MINUTES=15

# Fichier SQLite (créé automatiquement)
DB_PATH=./data/qos.sqlite

# --- Alertes automatiques ---

# URL de webhook (Slack, Discord, Mattermost, ntfy.sh...) qui reçoit un POST JSON
# à chaque nouvelle alerte. Laisser vide pour désactiver les notifications externes
# (les alertes restent visibles dans le dashboard et via GET /api/alerts).
ALERT_WEBHOOK_URL=

# En dessous de ce taux de délivrance (0.8 = 80%), une alerte est ouverte pour la route
ALERT_DELIVERY_RATE_THRESHOLD=0.8

# Nombre minimum de tests récents sur une route avant d'évaluer son taux de délivrance
# (évite les fausses alertes sur une route qui vient d'être créée)
ALERT_DELIVERY_RATE_MIN_SAMPLES=5

# Alerte si un device n'a plus donné signe de vie depuis ce nombre de minutes
ALERT_DEVICE_STALE_MINUTES=60

# --- Intégration TestSMS.com (tests vers un fournisseur externe, voir page
# "Tests fournisseurs" du dashboard) ---

# Client ID / Client Secret générés dans le portail TestSMS (section API).
# Laisser vide désactive silencieusement cette fonctionnalité (planifications
# ignorées, endpoints /api/testsms/* renvoient une erreur claire).
TESTSMS_CLIENT_ID=
TESTSMS_CLIENT_SECRET=

# URL publique du backend, utilisée pour construire le callbackUrl envoyé à
# TestSMS (ils nous rappellent dès qu'un résultat de test est disponible).
# Doit être joignable depuis l'extérieur en HTTPS.
PUBLIC_BASE_URL=https://188-245-8-33.sslip.io
